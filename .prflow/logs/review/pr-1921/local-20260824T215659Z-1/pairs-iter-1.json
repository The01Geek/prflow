    "category": "absolute_claim",
    "claim_provenance": "source_authored",
    "source_file": "scripts/scrub-credentials.sh",
    "source_excerpt": "Never list `\\` inside the two Authorization bracket expressions and never relax `{4,}` back to `+`: a POSIX bracket expression takes `\\` as a set member, so the token match swallows a following JSON escape backslash, and `+` matches a bare `//` as a token."
   },
   "verdict_path": ".prflow/tmp/review/pr-1921/local-20260824T215659Z-1/verdicts/iter-1/VC-6-c3a8f591.json",
   "response_text": ""
  },
  {
